 */

.jp-cell-button .jp-icon3[fill] {
  fill: var(--jp-inverse-layout-color4);
}

.jp-cell-button:hover .jp-icon3[fill] {
  fill: var(--jp-inverse-layout-color2);
}

.jp-toolbar-overlap .jp-cell-toolbar {
  display: none;
}

.jp-cell-toolbar {
  display: flex;
  flex-direction: row;
  padding: 2px 0;
  min-height: 25px;
  z-index: 6;
  position: absolute;
  top: 5px;
  right: 8px;

  /* Override .jp-Toolbar */
  background-color: transparent;

ist<span class="ͼ19">(</span>range<span class="ͼ19">(</span>len<span class="ͼ19">(</span>years<span class="ͼ19">)</span><span class="ͼ19">)</span><span class="ͼ19">)</span></div><div class="cm-line"><br></div><div class="cm-line"><span class="ͼs">for</span> i<span class="ͼ19">,</span> property_type <span class="ͼs">in</span> enumerate<span class="ͼ19">(</span>property_types<span class="ͼ19">)</span>:</div><div class="cm-line">    subset <span class="ͼ10">=</span> house_per_year<span class="ͼ14">[</span>house_per_year<span class="ͼ14">[</span><span class="ͼ12">'Type'</span><span class="ͼ14">]</span> <span class="ͼ10">==</span> property_type<span class="ͼ14">]</span></div><div class="cm-line">    bars <span class="ͼ10">=</span> plt<span class="ͼ19">.</span><span class="ͼz">bar</span><span class="ͼ19">(</span><span class="ͼ14">[</span>p <span class="ͼ10">+</span> i <span class="ͼ10">*</span> bar_width <span class="ͼs">for</span> p <span class="ͼs">in</span> positions<span class="ͼ14">]</span><span class="ͼ19">,</span> subset<span class="ͼ14">[</span><span class="ͼ12">'Count'</span><span class="ͼ14">]</span><span class="ͼ19">,</span> width<span class="ͼ10">=</span>bar_width<span class="ͼ19">,</span> label<span class="ͼ10">=</span>property_type<span class="ͼ19">)</span></div><div class="cm-line">    </div><div class="cm-line">    <span class="ͼ11"># to add counts number for each bar</span></div><div class="cm-line">    <span class="ͼs">for</span> bar <span class="ͼs">in</span> bars:</div><div class="cm-line">        height <span class="ͼ10">=</span> bar<span class="ͼ19">.</span><span class="ͼz">get_height</span><span class="ͼ19">(</span><span class="ͼ19">)</span></div><div class="cm-line">        plt<span class="ͼ19">.</span><span class="ͼz">text</span><span class="ͼ19">(</span>bar<span class="ͼ19">.</span><span class="ͼz">get_x</span><span class="ͼ19">(</span><span class="ͼ19">)</span> <span class="ͼ10">+</span> bar<span class="ͼ19">.</span><span class="ͼz">get_width</span><span class="ͼ19">(</span><span class="ͼ19">)</span><span class="ͼ10">/</span><span class="ͼu">2</span><span class="ͼ19">,</span> height<span class="ͼ19">,</span> <span class="ͼ13">f'</span><span class="ͼ14">{</span>int<span class="ͼ19">(</span>height<span class="ͼ19">)</span><span class="ͼ14">}</span><span class="ͼ13">'</span><span class="ͼ19">,</span> ha<span class="ͼ10">=</span><span class="ͼ12">'center'</span><span class="ͼ19">,</span> va<span class="ͼ10">=</span><span class="ͼ12">'bottom'</span><span class="ͼ19">)</span></div><div class="cm-line"><br></div><div class="cm-line"><span class="ͼ11"># Adding labels and title</span></div><div class="cm-line">plt<span class="ͼ19">.</span><span class="ͼz">xlabel</span><span class="ͼ19">(</span><span class="ͼ12">'Year'</span><span class="ͼ19">)</span></div><div class="cm-line">plt<span class="ͼ19">.</span><span class="ͼz">ylabel</span><span class="ͼ19">(</span><span class="ͼ12">'Number of Properties Sold'</span><span class="ͼ19">)</span></div><div class="cm-line">plt<span class="ͼ19">.</span><span class="ͼz">title</span><span class="ͼ19">(</span><span class="ͼ12">'Properties Sold by Type per Year'</span><span class="ͼ19">)</span></div><div class="cm-line">plt<span class="ͼ19">.</span><span class="ͼz">xticks</span><span class="ͼ19">(</span><span class="ͼ14">[</span>p <span class="ͼ10">+</span> bar_width <span class="ͼs">for</span> p <span class="ͼs">in</span> positions<span class="ͼ14">]</span><span class="ͼ19">,</span> years<span class="ͼ19">)</span></div><div class="cm-line">plt<span class="ͼ19">.</span><span class="ͼz">legend</span><span class="ͼ19">(</span>title<span class="ͼ10">=</span><span class="ͼ12">'Property Type'</span><span class="ͼ19">)</span></div><div class="cm-line"><br></div><div class="cm-line"><span class="ͼ11"># Display the chart</span></div><div class="cm-line">plt<span class="ͼ19">.</span><span class="ͼz">tight_layout</span><span class="ͼ19">(</span><span class="ͼ19">)</span></div><div class="cm